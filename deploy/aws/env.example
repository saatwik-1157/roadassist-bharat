# /opt/roadassist/.env on the EC2 instance — a copy of what Render has today.
# Copy each SECRET value from Render (roadassist -> Environment) yourself.
# Never commit the filled-in file.

NODE_ENV=demo
PORT=8080
HOST=0.0.0.0
CLIENT_IP_HEADER=cf-connecting-ip
TRUST_PROXY=true
CORS_ORIGINS=https://roadassistbharat.online,https://www.roadassistbharat.online,https://app.roadassistbharat.online
SMS_PROVIDER=console
PAYMENTS_PROVIDER=mock
SEED_DEMO_FLEET=true
EXPOSE_DEV_OTP=true
UPLOAD_DIR=/repo/app/var/uploads
EMAIL_PROVIDER=http
EMAIL_BASE_URL=https://api.resend.com/emails
EMAIL_FROM=RoadAssist-Bharat <alerts@send.roadassistbharat.online>
ALERT_LABEL=RoadAssist-Bharat on AWS

# ── secrets: paste from Render ────────────────────────────────────────────
# The same Neon database the Render service uses (the roadassist_app string).
DATABASE_URL=
# The Neon owner string, used only for migrations at boot.
MIGRATION_DATABASE_URL=
# Copy Render's value, so sessions survive moving between the two hosts.
JWT_SECRET=
EMAIL_API_KEY=
ALERT_EMAIL_TO=
EMAIL_SIGNIN=
