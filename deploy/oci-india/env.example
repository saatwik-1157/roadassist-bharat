# /opt/roadassist/.env on the OCI India VM.
#
# Derived from render.yaml (what the live Render service sets) and
# app/.env.example (what the app reads). PLACEHOLDERS ONLY: replace every
# <...>. Never commit the filled-in file, and never paste it into a chat or an
# issue. Keep it readable by root only:
#
#   sudo chmod 600 /opt/roadassist/.env
#
# compose.yml reads this file for ${...} substitution and hands the app ONLY
# the variables it lists, so the database passwords below reach the database,
# the backup job and the migration step, not the running API.
#
# Generate each password on the VM with:   openssl rand -hex 32
# Hex needs no escaping in a URL or here. (Compose expands `$`, so a value
# containing `$` would have to be written `$$`.)

# ── the database on this VM ─────────────────────────────────────────────────
# Read ONCE, when the database volume is first created
# (db-init/10-roadassist-roles.sh). Changing them here later does not change
# the database: see README, "Changing a database password".
#
# The superuser: backups and first-start setup only. The app never sees it.
POSTGRES_PASSWORD=<openssl rand -hex 32>
# roadassist_owner: owns the tables, runs the migrations (compose builds
# MIGRATION_DATABASE_URL from it; docker-start.sh unsets that before the API).
DB_OWNER_PASSWORD=<openssl rand -hex 32>
# roadassist_app: the API's least-privilege role (compose builds DATABASE_URL).
DB_APP_PASSWORD=<openssl rand -hex 32>

# DATABASE_URL and MIGRATION_DATABASE_URL are NOT set here: compose.yml builds
# both from the passwords above, pointing at the `db` container:
#   DATABASE_URL=postgres://roadassist_app:<DB_APP_PASSWORD>@db:5432/roadassist
#   MIGRATION_DATABASE_URL=postgres://roadassist_owner:<DB_OWNER_PASSWORD>@db:5432/roadassist

# Backups (compose.yml, `backup` service): hour of day in UTC (21 = 02:30 IST)
# and age in days after which a dump is deleted (6 keeps the last 7 dailies).
BACKUP_AT_HOUR=21
BACKUP_KEEP_DAYS=6

# ── which names Caddy serves (compose.yml -> Caddyfile) ─────────────────────
# While testing before the DNS switch (README step e): the temporary precheck
# name ONLY, so Caddy does not ask Let's Encrypt for app.* while app.* still
# points at Render. At the switch (README step f): app.roadassistbharat.online
SITE_ADDRESSES=precheck.roadassistbharat.online

# Image tag to run. `latest` follows main; `sha-<short>` pins one build.
IMAGE_TAG=latest

# ── the app (same values as render.yaml unless noted) ───────────────────────
# NOT "production": the production guard in env.ts refuses to boot without a
# real payment gateway, a real SMS provider and webhook secrets.
NODE_ENV=demo

# Copy Render's value (roadassist -> Environment -> JWT_SECRET -> eye icon), so
# sessions signed on Render stay valid here and the switch signs nobody out.
JWT_SECRET=<copy JWT_SECRET from Render>

# The showcase reads /health cross-origin before it frames the platform; an
# unset value would reflect any Origin.
CORS_ORIGINS=https://roadassistbharat.online,https://www.roadassistbharat.online,https://app.roadassistbharat.online

SMS_PROVIDER=console
PAYMENTS_PROVIDER=mock
# DELIBERATE, as on Render: with no SMS provider the OTP is shown on screen,
# and under NODE_ENV=demo only for the published demo numbers.
EXPOSE_DEV_OTP=true
# 24 SIMULATED mechanics on the NH-48 corridor, seeded idempotently at boot.
SEED_DEMO_FLEET=true

# Operator alerts and email sign-in, through Resend (USA; declared in
# app/scripts/check-data-residency.mjs).
EMAIL_PROVIDER=http
EMAIL_BASE_URL=https://api.resend.com/emails
EMAIL_FROM=RoadAssist-Bharat <alerts@send.roadassistbharat.online>
# Copy each of these three from Render (roadassist -> Environment). An empty
# ALERT_EMAIL_TO turns alerts off; an empty EMAIL_SIGNIN means phone only.
EMAIL_API_KEY=<copy EMAIL_API_KEY from Render>
ALERT_EMAIL_TO=<copy ALERT_EMAIL_TO from Render>
EMAIL_SIGNIN=<copy EMAIL_SIGNIN from Render>
ALERT_LABEL=RoadAssist-Bharat on OCI India

# Telegram alerts for emergency contacts. Copy all three from Render if it has
# them; leave all three empty to keep the feature off. The webhook URL is on
# the same name (app.roadassistbharat.online), so it needs no re-registration
# after the DNS switch.
TELEGRAM_BOT_TOKEN=<copy from Render, or leave empty>
TELEGRAM_BOT_USERNAME=<copy from Render, or leave empty>
TELEGRAM_WEBHOOK_SECRET=<copy from Render, or leave empty>
# Sign in with Google (all of the first three, or none). The redirect URI must
# name THIS host and be registered on the web client in Google Cloud Console.
GOOGLE_CLIENT_ID=<copy from Render, or leave empty>
GOOGLE_CLIENT_SECRET=<copy from Render, or leave empty>
GOOGLE_REDIRECT_URI=<https://this-host/v1/auth/google/callback, or leave empty>
GOOGLE_ANDROID_CLIENT_ID=<copy from Render, or leave empty>

# ── fixed in compose.yml, listed so nothing is hidden ───────────────────────
# Writing these here has NO effect; compose.yml sets them:
#   PORT=8080  HOST=0.0.0.0  UPLOAD_DIR=/repo/app/var/uploads
#   TRUST_PROXY=172.30.53.10   Caddy's fixed address on the compose network
#   CLIENT_IP_HEADER=          EMPTY. Render's cf-connecting-ip would be wrong
#                              here: no Cloudflare is in front of this VM, so a
#                              caller could forge it.
#
# The app's tunables (OTP_MAX_ATTEMPTS, OTP_IP_MAX, OFFER_TTL_SECONDS,
# DISPATCH_*, GEO_SERVICES, PHOTO_STORE, REPORT_*; see app/.env.example) keep
# their defaults, as on Render. To change one, add it to the app's
# `environment:` in compose.yml as well as here - only listed variables reach
# the app.
