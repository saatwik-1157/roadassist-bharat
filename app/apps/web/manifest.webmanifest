        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Track booking",
      "short_name": "Track",
      "description": "Follow your mechanic on the way to you",
      "url": "/app.html#track",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Report a hazard",
      "short_name": "Report",
      "description": "Flag a pothole or blockage for the authority",
      "url": "/app.html#report",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Off-grid mode",
      "short_name": "Off-grid",
      "description": "Your stored incident, local diagnosis and cached maps",
