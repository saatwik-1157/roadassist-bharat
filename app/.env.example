# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys,
# and never paste them into a chat or an issue.
#
#   cp .env.example .env
#
# Every provider below is optional. With none configured the platform runs
# end to end on local implementations, which is how the offline demo works.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://roadassist:devpassword@localhost:5434/roadassist

# ── auth ────────────────────────────────────────────────────────────────────
# Generate a real one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TTL_SECONDS=600
REFRESH_TTL_DAYS=30

# In development every OTP is DEV_OTP and it is echoed in the response.
# Both MUST change before production; the server refuses to boot otherwise.
DEV_OTP=000000
EXPOSE_DEV_OTP=true

# ── SMS / OTP delivery ──────────────────────────────────────────────────────
# console = log only (default).  twilio | msg91 = real delivery adapters.
#   twilio: SMS_API_KEY="ACCOUNT_SID:AUTH_TOKEN", SMS_SENDER_ID = your Twilio
#           number (or approved alphanumeric sender).
#   msg91:  SMS_API_KEY = authkey; needs a TRAI DLT-registered template
#           (SMS_DLT_TEMPLATE_ID) whose variable name matches SMS_DLT_VAR.
# SMS_BASE_URL overrides the vendor host — for stub testing only.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_BASE_URL=
SMS_SENDER_ID=RDASST
SMS_DLT_TEMPLATE_ID=
SMS_DLT_VAR=otp

# Inbound telecom webhook authentication. When set, POST /v1/telecom/sms must
# carry x-roadassist-signature = HMAC-SHA256(secret, raw body) hex. REQUIRED
# in production — the server refuses to boot without it.
TELECOM_WEBHOOK_SECRET=

# Per-IP ceiling on OTP requests in the same window (per-number limit is
# OTP_MAX_ATTEMPTS above; threat #1 requires both axes).
OTP_IP_MAX=30

# ── maps / routing ──────────────────────────────────────────────────────────
# local = Haversine estimate (default, no account needed).
MAPS_PROVIDER=local
MAPS_API_KEY=
MAPS_BASE_URL=

# ── AI diagnosis ────────────────────────────────────────────────────────────
# rules = deterministic rules engine (default, and the permanent fallback).
# http  = call a remote model; the rules result is still computed and wins
#         whenever the model is unconfident or claims a stricter verdict is safe.
AI_PROVIDER=rules
AI_API_KEY=
AI_BASE_URL=
AI_MIN_CONFIDENCE=0.45
AI_TIMEOUT_MS=3000

# ── payments ────────────────────────────────────────────────────────────────
PAYMENTS_PROVIDER=mock
PAYMENTS_KEY_ID=
PAYMENTS_KEY_SECRET=

# ── email ─────────────────────────────────────────────────────────────────
# console = log only (default). http = POST to a transactional email API
# (SendGrid / Mailgun / Resend) at EMAIL_BASE_URL with EMAIL_API_KEY as Bearer.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_BASE_URL=
EMAIL_FROM=RoadAssist <no-reply@roadassist.in>
