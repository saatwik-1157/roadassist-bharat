# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys,
# and never paste them into a chat or an issue.
#
#   cp .env.example .env
#
# Every provider below is optional. With none configured the platform runs
# end to end on local implementations, which is how the offline demo works.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://roadassist:devpassword@localhost:5434/roadassist

# ── auth ────────────────────────────────────────────────────────────────────
# Generate a real one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TTL_SECONDS=600
REFRESH_TTL_DAYS=30

# In development every OTP is DEV_OTP and it is echoed in the response.
# Both MUST change before production; the server refuses to boot otherwise.
DEV_OTP=000000
EXPOSE_DEV_OTP=true

# ── SMS / OTP delivery ──────────────────────────────────────────────────────
# console = log only (default).  twilio | msg91 = real delivery adapters.
#   twilio: SMS_API_KEY="ACCOUNT_SID:AUTH_TOKEN", SMS_SENDER_ID = your Twilio
#           number (or approved alphanumeric sender).
#   msg91:  SMS_API_KEY = authkey; needs a TRAI DLT-registered template
#           (SMS_DLT_TEMPLATE_ID) whose variable name matches SMS_DLT_VAR.
# SMS_BASE_URL overrides the vendor host — for stub testing only.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_BASE_URL=
SMS_SENDER_ID=RDASST
SMS_DLT_TEMPLATE_ID=
SMS_DLT_VAR=otp

# Inbound telecom webhook authentication. When set, POST /v1/telecom/sms must
# carry x-roadassist-signature = HMAC-SHA256(secret, raw body) hex. REQUIRED
# in production — the server refuses to boot without it.
TELECOM_WEBHOOK_SECRET=

# Per-IP ceiling on OTP requests in the same window (per-number limit is
# OTP_MAX_ATTEMPTS above; threat #1 requires both axes).
OTP_IP_MAX=30

# Believe the upstream proxy's X-Forwarded-For. Required behind a tunnel, load
# balancer or CDN — without it every user shares one apparent IP and the OTP
# ceiling above becomes a single bucket for everyone. Leave OFF when the server
# is reached directly: a client could otherwise forge the header itself.
# true | a comma-separated list of trusted proxy addresses/CIDRs
# Set to the address of your proxy, not `true`. Behind a local tunnel that is
# `127.0.0.1,::1`; behind a cloud load balancer it is the balancer's subnet.
# `true` trusts every hop, which lets any client that can reach the port forge
# X-Forwarded-For and bypass the per-IP OTP ceiling entirely.
# A hop count (1, 2, …) is REJECTED at startup — it was removed upstream as
# GHSA-3m5p-2c4r-xxw2, because counting hops never checks who actually sent the
# header. Use the address list instead.
TRUST_PROXY=

# How long a dispatch offer stays acceptable. 90s is right for real dispatch;
# raise it while demonstrating, because narrating the offer and switching to
# the mechanic console takes longer than the offer lives.
OFFER_TTL_SECONDS=90


# ── maps / routing ──────────────────────────────────────────────────────────
# local = Haversine estimate (default, no account needed).
MAPS_PROVIDER=local
MAPS_API_KEY=
MAPS_BASE_URL=

# ── AI diagnosis ────────────────────────────────────────────────────────────
# rules = deterministic rules engine (default, and the permanent fallback).
# http  = call a remote model; the rules result is still computed and wins
#         whenever the model is unconfident or claims a stricter verdict is safe.
AI_PROVIDER=rules
AI_API_KEY=
AI_BASE_URL=
AI_MIN_CONFIDENCE=0.45
AI_TIMEOUT_MS=3000

# ── payments ────────────────────────────────────────────────────────────────
# mock = settle locally, no gateway and no money (the default, and what the
#        offline demo and the test suite run against).
# razorpay = real Orders + Checkout. PAYMENTS_KEY_ID / PAYMENTS_KEY_SECRET are
#        the dashboard key pair; the secret also verifies the checkout signature,
#        so it must never reach a client.
# Production refuses to boot on 'mock', or on a real gateway with no key pair.
# PAYMENTS_BASE_URL overrides the gateway host — for stub testing only.
PAYMENTS_PROVIDER=mock
PAYMENTS_KEY_ID=
PAYMENTS_KEY_SECRET=
# Razorpay webhook signing secret (Dashboard -> Settings -> Webhooks). This is a
# DIFFERENT value from PAYMENTS_KEY_SECRET. Point the webhook at
#   https://<your-host>/v1/webhooks/razorpay   with the event: payment.captured
# Required whenever a real gateway is used: the browser callback after checkout
# is not a reliable settlement signal, because the payer can close the tab.
PAYMENTS_WEBHOOK_SECRET=

PAYMENTS_BASE_URL=

# ── email ─────────────────────────────────────────────────────────────────
# console = log only (default). http = POST to a transactional email API
# (SendGrid / Mailgun / Resend) at EMAIL_BASE_URL with EMAIL_API_KEY as Bearer.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_BASE_URL=
EMAIL_FROM=RoadAssist <no-reply@roadassist.in>

# ── Off-Grid Mode, dispatch and real-time (ADR-0009, ADR-0010) ──────────────
# All optional; the defaults shown are what the platform uses when unset.

# Providers offered a job per dispatch wave. 1 is the strict one-at-a-time
# ladder (A is asked, A does not answer, B is asked); 5 broadcasts to the best
# five and escalates to the next five. Breadth finds somebody faster on a
# hard shoulder at 2am; order is fairer to providers and cheaper in messages.
DISPATCH_WAVE_SIZE=5
# Radius used when the ladder escalates on its own, with no caller to ask.
DISPATCH_RADIUS_KM=25
# How often expired offers are closed and the ladder advanced. This IS the
# dispatch timeout: without it an unanswered offer leaves a booking in MATCHING
# with nothing scheduled to move it on.
OFFER_SWEEP_SECONDS=10

# ── CORS ───────────────────────────────────────────────────────────────────
# UNSET in development, which reflects whatever origin asks — that is what lets
# a demo work from localhost, a LAN address and a Cloudflare tunnel in the same
# afternoon.
#
# REQUIRED in production. Reflecting the caller's Origin is functionally "any
# website may call this API with the user's credentials attached", so
# assertProductionSafe refuses to boot without an explicit https allowlist.
# Comma-separated full origins — scheme://host[:port], no trailing slash.
# CORS_ORIGINS=https://app.roadassist.in,https://admin.roadassist.in

# ── Local file storage ─────────────────────────────────────────────────────
# Hazard-report photos (ADR-0006 keeps only the reference in the database).
# Defaults to ./uploads relative to the working directory. In a container this
# MUST point at a mounted volume, or the write fails with EACCES and the photo
# is lost on restart. The production image sets it to /repo/app/var/uploads.
# UPLOAD_DIR=/repo/app/var/uploads
# UPLOAD_MAX_BYTES=4000000
