<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY. Replaces src/main/res/xml/network_security_config.xml
     in the debug variant; a release build never sees this file.

     A developer's API runs over plain HTTP on their own machine, so a debug
     build may speak cleartext to exactly two places:
       · 10.0.2.2   the Android emulator's alias for the host machine
       · localhost  (and 127.0.0.1) for a phone on USB with
                    `adb reverse tcp:4000 tcp:4000`
     Everything else, the live platform included, is HTTPS only, exactly as
     in a release build. A LAN address (192.168.x.x) is deliberately not
     here: a network security config cannot say "any private address", and
     adb reverse reaches the same laptop without widening this list. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
