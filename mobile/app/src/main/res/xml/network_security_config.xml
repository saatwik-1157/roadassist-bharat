<?xml version="1.0" encoding="utf-8"?>
<!-- Who this app may talk to in cleartext: in a release build, nobody.

     The default server is the live platform over HTTPS (Api.DEFAULT_BASE),
     and a release build speaks HTTPS to every host, whatever is typed into
     the server field. A phone number, a sign-in code and a bearer token are
     never sent over plain HTTP from a build that can be handed to somebody.

     Development still needs plain HTTP, because the API on a laptop has no
     certificate. That allowance lives ONLY in the debug build's copy of this
     file (src/debug/res/xml/network_security_config.xml), which Gradle merges
     over this one for debug and never for release, and it names the
     emulator host and localhost alone.

     Api.needsHttps asks the platform the same question before connecting, so
     a refused address is explained on the screen (server_https_required)
     rather than failing with the platform's policy exception. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
