<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The SOS fallback ladder: SMS when there's no data, dialer for 112. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Real SOS location (best-effort last-known fix; no Play Services needed). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- SEND_SMS and the location permissions make Google Play assume telephony
         and GPS hardware are REQUIRED, which would hide the app from tablets and
         ChromeOS. The SMS ladder is a fallback, not a precondition: a device with
         no radio still books over data, and one with no GPS still raises an SOS
         with a typed location. Declaring them optional keeps the install base as
         wide as the product claims — and the runtime code already treats every
         one of these as "may be absent". -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Android 11+ package visibility: needed to hand off to the dialer. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <!-- The default server is the live platform over HTTPS. Cleartext stays
         allowed for development only because a developer's API runs over
         plain HTTP on their own machine (10.0.2.2 from an emulator, a LAN
         address from a phone), and those addresses cannot be enumerated.
         network_security_config.xml keeps that exactly as permissive as
         before and additionally REFUSES cleartext to the live domain. On
         API 24+ that file takes precedence over usesCleartextTraffic, which is
         kept only so the intent reads the same in both places. A store build
         would drop the base-config allowance and ship HTTPS only. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.RoadAssist"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
