<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The SOS fallback ladder: SMS when there's no data, dialer for 112. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Real SOS location (best-effort last-known fix; no Play Services needed). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Scan road: the live camera view the on-device detector looks at. Asked
         for only when "Use camera" is tapped; frames never leave the phone
         unless the person sends a hazard report with one attached. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The SOS ladder's 112 handoff from the background: Android 10+ blocks
         opening the dialer then, so a tap-to-call notification goes up
         instead. Asked for with the SOS permissions, on Android 13+ only. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- SEND_SMS and the location permissions make Google Play assume telephony
         and GPS hardware are REQUIRED, which would hide the app from tablets and
         ChromeOS. The SMS ladder is a fallback, not a precondition: a device with
         no radio still books over data, and one with no GPS still raises an SOS
         with a typed location. Declaring them optional keeps the install base as
         wide as the product claims — and the runtime code already treats every
         one of these as "may be absent". -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- The scanner also works on a picked photo, so a device with no camera
         keeps the app and every other feature. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Android 11+ package visibility: needed to hand off to the dialer. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <!-- HTTPS only in a release build. network_security_config.xml refuses
         cleartext to every host; the debug build swaps in its own copy
         (src/debug/res/xml/network_security_config.xml) that allows plain
         HTTP to the emulator host 10.0.2.2 and localhost and nowhere else,
         because a developer's API runs over plain HTTP on their own machine.
         A phone reaches a laptop's API through `adb reverse tcp:4000 tcp:4000`
         and localhost:4000. android:usesCleartextTraffic is gone: on API 24+
         the config file decides, and a second switch here that said the
         opposite was only something to misread.
         enableOnBackInvokedCallback opts in to predictive back on Android 13+.
         Every back path (Compose BackHandler, dialogs, the Layers WebView)
         goes through the OnBackPressedDispatcher; nothing overrides
         onBackPressed, which predictive back no longer calls. Android 8–12
         ignore the attribute and keep classic back (tools:targetApi says
         that is intended).
         allowBackup is off: the app keeps queued SOS records (where and when
         a crash happened) and trip data on the device, and none of it belongs
         in a cloud backup or an adb backup of the phone. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.RoadAssist"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">

        <!-- ONNX Runtime for Android (1.30) ships a content provider that
             starts at every app launch, loads the 33 MB native library and
             sends usage telemetry, with device identifiers, to Microsoft's
             collector outside India. This app's data stays in India and the
             detector is meant to work with no network at all, so the provider
             is removed from the merged manifest; OrtRoadDetector also turns
             the runtime's telemetry off. Verified absent from the built APK. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
