# dependencies & build output
node_modules/
dist/
*.tsbuildinfo

# environment & secrets — only .env.example is ever committed
.env
.env.*
!.env.example

# simulator local state (contains a device credential)
app/scripts/.raksha-sim-state.json

# citizen hazard-report photos (local disk store; never object storage in dev)
uploads/
app/apps/api/uploads/

# editor noise
.vscode/
.idea/
*.swp

# AI toolchain — heavy local artifacts never enter git
ai/.venv/
ai/data/
ai/runs/
ai/*.zip
ai/**/*.pt
ai/**/*.onnx
runs/
weights/
ai/cv-detections.json
ai/label_map.pbtxt

# Android app — build artifacts and machine-specific config
mobile/.gradle/
mobile/build/
mobile/app/build/
mobile/local.properties
mobile/*.png
mobile/build.log
mobile/build*.log
# Kotlin 2.x writes per-session build state here; it is regenerated every run.
mobile/.kotlin/

# Generated deck artefacts. `make.py` and `make_final.py` concatenate
# build_deck.py with the slide parts into these files and run them — they are
# build output, not source, and committing them means two copies of the deck
# code that will disagree.
ppt/make_generated.py
ppt/make_final_generated.py
ppt/assets/_fit_*.png
__pycache__/
*.pyc

# The pre-audit copies kept while correcting over-claims. Useful locally as a
# diff; not something the submission needs.
review1-ppt/*.pre-audit.pptx
review1-ppt/*.pre-audit.pdf
