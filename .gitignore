# dependencies & build output
node_modules/
dist/
*.tsbuildinfo

# environment & secrets — only .env.example is ever committed
.env
.env.*
!.env.example

# simulator local state (contains a device credential)
app/scripts/.raksha-sim-state.json

# citizen hazard-report photos (local disk store; never object storage in dev)
uploads/
app/apps/api/uploads/

# editor noise
.vscode/
.idea/
*.swp

# AI toolchain — heavy local artifacts never enter git
ai/.venv/
ai/data/
ai/runs/
ai/*.zip
ai/**/*.pt
ai/**/*.onnx
runs/
weights/
ai/cv-detections.json
ai/label_map.pbtxt

# Android app — build artifacts and machine-specific config
mobile/.gradle/
mobile/build/
mobile/app/build/
mobile/local.properties
mobile/*.png
mobile/build.log
mobile/build*.log
# Kotlin 2.x writes per-session build state here; it is regenerated every run.
mobile/.kotlin/

__pycache__/
*.pyc

# The pre-audit copies kept while correcting over-claims. Useful locally as a
# diff; not something the submission needs.
review1-ppt/*.pre-audit.pptx
review1-ppt/*.pre-audit.pdf

# Local assistant/editor state - never part of the project
.claude/

# Assistant skill state, same category as .claude/ — not part of the project
skills-lock.json

# Release APKs are build output, handed over by path, never committed.
mobile/*.apk
# The signed release hand-over folder: INSTALL.md is committed, the binaries
# are not (they are rebuilt from source and are tens of MB each).
release/*.apk
release/*.aab

# Signing keys and service credentials: none exist in this repo, and none may
# ever be committed by accident.
*.jks
*.keystore
keystore.properties
*.p12
*.pem
google-services.json
GoogleService-Info.plist
